<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="cuadernos"/>
        <attribute name="authors" value="Luisa"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-23 08:17:13 p.&#8239;m."/>
        <attribute name="created" value="THVpc2E7TFVJU0EyMDA1OzIwMjYtMDQtMjM7MDc6NTQ6MDMgcC7igK9tLjsxMDc2OA=="/>
        <attribute name="edited" value="THVpc2E7TFVJU0EyMDA1OzIwMjYtMDQtMjM7MDg6MTc6MTMgcC7igK9tLjsxOzEwODc3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="cantidad, precio" type="Integer" array="False" size=""/>
            <input variable="cantidad"/>
            <if expression="cantidad&gt;1000">
                <then>
                    <assign variable="total" expression="(cantidad*2500)+0.8"/>
                </then>
                <else>
                    <assign variable="total" expression="cantidad+2500"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
