        <attribute name="edited" value="THVpc2E7TFVJU0EyMDA1OzIwMjYtMDQtMzA7MDc6MTA6NTMgcC7igK9tLjsxO0x1aXNhO0xVSVNBMjAwNTsyMDI2LTA0LTMwOzA2OjMxOjQwIHAu4oCvbS47MjE2OTE="/>
        <attribute name="edited" value="THVpc2E7TFVJU0EyMDA1OzIwMjYtMDQtMzA7MDc6MTI6NDUgcC7igK9tLjsxOzEwODc0"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, cant" type="Integer" array="False" size=""/>
            <input variable="cant"/>
            <for variable="i" start="1" end="cant" direction="inc" step="1">
                <forward expression="100" pen="down"/>
                <turn expression="90" rotate="right"/>
                <forward expression="100" pen="down"/>
                <turn expression="90" rotate="left"/>
            </for>
            <turn expression="180" rotate="right"/>
            <forward expression="cant*100" pen="down"/>
            <turn expression="270" rotate="left"/>
            <forward expression="cant*100" pen="down"/>
        </body>
    </function>
</flowgorithm>
