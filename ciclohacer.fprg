        <attribute name="edited" value="THVpc2E7TFVJU0EyMDA1OzIwMjYtMDUtMTQ7MDc6NDM6MjYgcC7igK9tLjsxO0x1aXNhO0xVSVNBMjAwNTsyMDI2LTA1LTE0OzA3OjMzOjM5IHAu4oCvbS47Y2ljbG9taWVudHJhcy5mcHJnOzIzNjM5"/>
        <attribute name="edited" value="THVpc2E7TFVJU0EyMDA1OzIwMjYtMDUtMTQ7MDc6NTA6MzMgcC7igK9tLjsxOzEwODc2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="edad, promedio, cantidad, suma, I" type="Integer" array="False" size=""/>
            <input variable="cantidad"/>
            <assign variable="i" expression="0"/>
            <assign variable="suma" expression="0"/>
            <assign variable="edad" expression="0"/>
            <do expression="i&lt;cantidad">
                <input variable="edad"/>
                <assign variable="suma" expression="suma+edad"/>
                <assign variable="i" expression="i+1"/>
            </do>
            <assign variable="promedio" expression="suma/cantidad"/>
            <output expression="promedio" newline="True"/>
        </body>
    </function>
</flowgorithm>
