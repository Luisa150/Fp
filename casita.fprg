<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="casita"/>
        <attribute name="authors" value="Luisa"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-30 09:24:49 p.&#8239;m."/>
        <attribute name="created" value="THVpc2E7TFVJU0EyMDA1OzIwMjYtMDQtMzA7MDc6MzE6MzcgcC7igK9tLjsxMDc2OA=="/>
        <attribute name="edited" value="THVpc2E7TFVJU0EyMDA1OzIwMjYtMDQtMzA7MDk6MjQ6NDkgcC7igK9tLjsxOzEwODgz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="cant, x" type="Integer" array="False" size=""/>
            <input variable="cant"/>
            <for variable="x" start="1" end="cant" direction="inc" step="1">
                <call expression="hacercasitas"/>
            </for>
        </body>
    </function>
    <function name="hacercasitas" type="None" variable="">
        <parameters/>
        <body>
            <declare name="tam, alt, anch" type="Real" array="False" size=""/>
            <declare name="x" type="Integer" array="False" size=""/>
            <assign variable="tam" expression="random(100)"/>
            <assign variable="alt" expression="tam*10"/>
            <assign variable="anch" expression="tam*10"/>
            <call expression="hacerrectangulo(alt,anch)"/>
            <forward expression="alt" pen="down"/>
            <call expression="hacertriangulo(anch)"/>
            <turn expression="45" rotate="right"/>
            <forward expression="alt" pen="down"/>
            <turn expression="90" rotate="right"/>
            <forward expression="(anch/3)*2" pen="down"/>
            <turn expression="90" rotate="right"/>
            <call expression="hacerrectangulo((alt/4),(anch/4))"/>
            <turn expression="90" rotate="right"/>
            <forward expression="(anch/3)*2" pen="down"/>
            <turn expression="90" rotate="left"/>
        </body>
    </function>
    <function name="hacerrectangulo" type="None" variable="">
        <parameters>
            <parameter name="alt" type="Real" array="False"/>
            <parameter name="anc" type="Real" array="False"/>
        </parameters>
        <body>
            <declare name="x" type="Integer" array="False" size=""/>
            <for variable="x" start="1" end="2" direction="inc" step="1">
                <forward expression="alt" pen="down"/>
                <turn expression="90" rotate="right"/>
                <forward expression="anc" pen="down"/>
                <turn expression="90" rotate="right"/>
            </for>
        </body>
    </function>
    <function name="HACERTRIANGULO" type="None" variable="">
        <parameters>
            <parameter name="anc" type="Real" array="False"/>
        </parameters>
        <body>
            <turn expression="45" rotate="right"/>
            <forward expression="anc*(sqrt(2))/2" pen="down"/>
            <turn expression="90" rotate="right"/>
            <forward expression="anc*(sqrt(2))/2" pen="down"/>
        </body>
    </function>
</flowgorithm>
