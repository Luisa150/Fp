<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="CICLOPARA"/>
        <attribute name="authors" value="Luisa"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-14 07:28:29 p.&#8239;m."/>
        <attribute name="created" value="THVpc2E7TFVJU0EyMDA1OzIwMjYtMDUtMTQ7MDc6MDk6MzIgcC7igK9tLjsxMDc3MQ=="/>
        <attribute name="edited" value="THVpc2E7TFVJU0EyMDA1OzIwMjYtMDUtMTQ7MDc6Mjg6MjkgcC7igK9tLjsxOzEwODg2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="edad, promedio, cantidad, suma, I" type="Integer" array="False" size=""/>
            <input variable="cantidad"/>
            <assign variable="edad" expression="0"/>
            <assign variable="SUMA" expression="0"/>
            <for variable="I" start="edad" end="cantidad" direction="inc" step="1">
                <input variable="edad"/>
                <comment text="pido la edad"/>
                <assign variable="suma" expression="suma+edad"/>
            </for>
            <assign variable="promedio" expression="suma/cantidad"/>
            <output expression="promedio" newline="True"/>
        </body>
    </function>
</flowgorithm>
