        <attribute name="edited" value="THVpc2E7TFVJU0EyMDA1OzIwMjYtMDUtMTQ7MDc6MzM6NDIgcC7igK9tLjsxO0x1aXNhO0xVSVNBMjAwNTsyMDI2LTA1LTE0OzA3OjA5OjMyIHAu4oCvbS47Q0lDTE9QQVJBLmZwcmc7MjI4OTc="/>
        <attribute name="edited" value="THVpc2E7TFVJU0EyMDA1OzIwMjYtMDUtMTQ7MDc6NDI6NTcgcC7igK9tLjsxOzEwODgz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="edad, promedio, cantidad, suma, I" type="Integer" array="False" size=""/>
            <assign variable="i" expression="0"/>
            <assign variable="suma" expression="0"/>
            <assign variable="edad" expression="0"/>
            <input variable="cantidad"/>
            <while expression="i&lt;cantidad">
                <input variable="edad"/>
                <assign variable="suma" expression="suma+edad"/>
                <assign variable="i" expression="i+1"/>
            </while>
            <assign variable="promedio" expression="suma/cantidad"/>
            <output expression="promedio" newline="True"/>
        </body>
    </function>
</flowgorithm>
